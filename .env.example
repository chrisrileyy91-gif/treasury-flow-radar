# Required only when running either FRED series; the ingestion runner marks FRED as SKIPPED if this is empty.
# The application reads this from the process environment and does not load this file automatically.
# Create a key through a FRED account and provide it only through the runtime environment.
FRED_API_KEY=

# Optional: override the request User-Agent.
TFR_USER_AGENT=TreasuryFlowRadar/0.1.0

# Optional: SQLite path (defaults to data/treasury_flow_radar.sqlite3).
TREASURY_FLOW_RADAR_DB=data/treasury_flow_radar.sqlite3
